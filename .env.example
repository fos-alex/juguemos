POSTGRES_USER=ludi
POSTGRES_PASSWORD=ludi
POSTGRES_DB=ludi

# Development only: hot reload for the web and the API (compose.dev.yml), so a
# change needs no rebuild. Leave it out on the droplet, which serves the
# production build.
COMPOSE_FILE=docker-compose.yml:compose.dev.yml

# Emails allowed to sign up, comma-separated. Empty means nobody can: no outside
# testers until the guardrails are complete. An entry like @ludi.local lets
# any email at that domain sign up. Emails aren't verified yet, so a domain entry
# lets anyone who reaches the app in: use it only on your own machine.
SIGNUP_EMAILS=

# Required: signs sessions. Generate one per machine: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public origin the app is served from. On the droplet: https://ludi.ar
BETTER_AUTH_URL=https://ludi.local:3000

# The sites Caddy serves: local (ludi.local, and plain HTTP for Tailscale) or
# production (ludi.ar, with certificates from Let's Encrypt). The droplet sets
# production, and publishes HTTPS and HTTP to the internet with HTTPS_PORT=443
# and HTTP_PORT=80, which Let's Encrypt needs.
CADDY_SITES=local
CADDY_LOCAL_HOSTS=ludi.local
CADDY_DEFAULT_SNI=ludi.local
HTTPS_PORT=127.0.0.1:3000
HTTP_PORT=127.0.0.1:3001

# Other origins the app is opened from, comma-separated, such as the phone's
# Tailscale address: https://<machine>.<tailnet>.ts.net:8443. Sign-in and
# sign-up from any origin not listed here or above answer "Invalid origin".
TRUSTED_ORIGINS=

# Which LLM writes the stories: opencode (the default), openrouter, or
# claude-code, which runs the `claude` CLI that the API's Docker image installs.
LLM_PROVIDER=opencode

# The model, as the provider names it. OpenCode defaults to glm-5.3-flash.
# OpenRouter has no default: use a model id from openrouter.ai/models.
# Claude Code defaults to sonnet, and takes an alias (haiku, sonnet, opus) or a
# full model id.
LLM_MODEL=

# The chosen provider's key. Without it, stories come from the seeded templates.
# OpenCode's is in ~/.local/share/opencode/auth.json ("opencode-go.key").
OPENCODE_API_KEY=
# OpenRouter's is at openrouter.ai/settings/keys.
OPENROUTER_API_KEY=
# Claude Code's is an OAuth token for your Claude subscription: run
# `claude setup-token` on your computer and paste what it prints.
CLAUDE_CODE_OAUTH_TOKEN=

# How many episodes a story series holds before it is finished. Ten unless set.
STORY_SERIES_EPISODES=10

# Speech to text for voice notes. Empty means the Whisper server that Compose
# runs (the stt service). Any service with the OpenAI transcriptions API works
# instead, with its model and key, for example:
#   Groq:   STT_URL=https://api.groq.com/openai/v1  STT_MODEL=whisper-large-v3-turbo
#   OpenAI: STT_URL=https://api.openai.com/v1       STT_MODEL=gpt-4o-mini-transcribe
STT_URL=
STT_MODEL=
STT_API_KEY=

# Email, sent through an SMTP service. Empty SMTP_HOST means email is off.
# Resend's free plan: SMTP_HOST=smtp.resend.com, SMTP_USER=resend, and an API key
# from resend.com/api-keys as SMTP_PASSWORD. DigitalOcean blocks ports 25, 465,
# and 587 on droplets, so keep 2465 (TLS) or use 2587 (STARTTLS). EMAIL_FROM has
# to be at a domain verified with the service. Check it all with
# npm run email:test -w api -- you@example.com
SMTP_HOST=
SMTP_PORT=2465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Ludi <hola@ludi.ar>"

# The catalog admin at /admin, which has no login yet. Set it to true only on
# your own machine, never where anyone outside the family can reach it.
ADMIN_ENABLED=false

# Keep what parents send in their own words (the family text, and voice note
# transcriptions) in the audit_transcripts table, to audit the playtest. The
# texts hold the family's names, so leave it false in production.
AUDIT_TRANSCRIPTS=false
